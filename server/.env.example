# ============ 阿里云千问配置（推荐，默认） ============
ALIYUN_API_KEY=your-aliyun-api-key
ALIYUN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_MODEL_NAME=qwen-plus-latest
ALIYUN_EMBEDDING_MODEL_NAME=text-embedding-v1

# ============ DeepSeek 配置 ============
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat

# ============ GLM/智谱 配置 ============
GLM_API_KEY=your-glm-api-key
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL_NAME=glm-4

# ============ 火山/豆包 配置 ============
DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL_NAME=your-model-id

# ============ Kimi/月之暗面 配置 ============
KIMI_API_KEY=your-kimi-api-key
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_MODEL_NAME=moonshot-v1-8k

# ============ OpenAI 配置（用于 Whisper 语音转文字） ============
OPENAI_API_KEY=your-openai-api-key

# ============ 阿里云 OSS 配置（可选） ============
# 配置后将使用 OSS 存储上传的文件，否则使用本地存储
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_BUCKET_NAME=

# ============ Milvus 向量数据库配置 ============
MILVUS_HOST=192.168.21.254
MILVUS_PORT=19530

# ============ 通用配置 ============
DEBUG=True
TEMPERATURE=0
STORAGE_TYPE=local
